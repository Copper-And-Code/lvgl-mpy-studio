#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @IDE_FILEVERSION@
PRODUCTVERSION @IDE_FILEVERSION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nunzio Raciti"
            VALUE "FileDescription", "LVGL MPY Studio MicroPython Simulator Runtime"
            VALUE "FileVersion", "@IDE_VERSION@ (@IDE_COMMIT@)"
            VALUE "InternalName", "lvsim-runtime"
            VALUE "OriginalFilename", "lvsim-runtime.exe"
            VALUE "ProductName", "LVGL MPY Studio"
            VALUE "ProductVersion", "@IDE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
