  "code": {
    "module": "def screen_size():\n    display = lv.display_get_default()\n    return display.get_horizontal_resolution(), display.get_vertical_resolution()\n\n\nttt_cells = []\nttt_cpu = True\nttt_lines = [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6), (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)]\n\n\ndef ttt_reset():\n    global ttt_board, ttt_turn, ttt_over, ttt_cells\n    ttt_cells = [ui.cell_0, ui.cell_1, ui.cell_2, ui.cell_3, ui.cell_4, ui.cell_5, ui.cell_6, ui.cell_7, ui.cell_8]\n    ttt_board = [\"\"] * 9\n    ttt_turn = \"X\"\n    ttt_over = False\n    for cell in ttt_cells:\n        cell.get_child(0).set_text(\"\")\n        cell.set_style_bg_color(lv.color_hex(0x263449), lv.PART.MAIN)\n    ui.mode.get_child(0).set_text(\"CPU: ON\" if ttt_cpu else \"2 PLAYERS\")\n    ui.status.set_text(\"Your turn (X)\" if ttt_cpu else \"X's turn\")\n\n\ndef ttt_layout():\n    # Fits any screen: the unit is 1/240 of the short side.\n    width, height = screen_size()\n    unit = min(width, height) / 240\n    small = width < 400\n    margin, bar, gap = int(6 * unit), int(26 * unit), int(4 * unit)\n    ui.background.set_size(width, height)\n    button = (width - 3 * margin) // 2 if width < 600 else width // 4\n    ui.reset.set_pos(width - margin - button, margin)\n    ui.reset.set_size(button, bar)\n    ui.mode.set_pos(width - 2 * margin - 2 * button, margin)\n    ui.mode.set_size(button, bar)\n    if width < 600:\n        ui.title.add_flag(lv.obj.FLAG.HIDDEN)\n    ui.title.set_pos(margin, margin)\n    ui.title.set_size(width - 2 * button - 4 * margin, bar)\n    top = margin + bar + gap\n    ui.status.set_pos(margin, top)\n    ui.status.set_size(width - 2 * margin, int(16 * unit))\n    if small:\n        ui.status.set_style_text_font(lv.font_montserrat_14, lv.PART.MAIN)\n    top += int(18 * unit)\n    cell = (min(width - 2 * margin, height - top - margin) - 2 * gap) // 3\n    left = (width - 3 * cell - 2 * gap) // 2\n    for index, button in enumerate(ttt_cells):\n        button.set_pos(left + index % 3 * (cell + gap), top + index // 3 * (cell + gap))\n        button.set_size(cell, cell)\n\n\ndef ttt_toggle_mode():\n    global ttt_cpu\n    ttt_cpu = not ttt_cpu\n    ttt_reset()\n\n\ndef ttt_place(index):\n    global ttt_turn, ttt_over\n    ttt_board[index] = ttt_turn\n    ttt_cells[index].get_child(0).set_text(ttt_turn)\n    for a, b, c in ttt_lines:\n        if ttt_board[a] and ttt_board[a] == ttt_board[b] == ttt_board[c]:\n            ttt_over = True\n            for position in (a, b, c):\n                ttt_cells[position].set_style_bg_color(lv.color_hex(0x16834B), lv.PART.MAIN)\n            ui.status.set_text(ttt_turn + \" wins! Select NEW GAME\")\n            return\n    if \"\" not in ttt_board:\n        ttt_over = True\n        ui.status.set_text(\"Draw! Select NEW GAME\")\n        return\n    ttt_turn = \"O\" if ttt_turn == \"X\" else \"X\"\n    ui.status.set_text((\"Your turn (X)\" if ttt_turn == \"X\" else \"CPU is playing...\") if ttt_cpu else ttt_turn + \"'s turn\")\n\n\ndef ttt_winning_move(symbol):\n    for a, b, c in ttt_lines:\n        line = [ttt_board[a], ttt_board[b], ttt_board[c]]\n        if line.count(symbol) == 2 and \"\" in line:\n            return (a, b, c)[line.index(\"\")]\n    return -1\n\n\ndef ttt_cpu_move():\n    move = ttt_winning_move(\"O\")\n    if move < 0:\n        move = ttt_winning_move(\"X\")\n    if move < 0 and not ttt_board[4]:\n        move = 4\n    if move < 0:\n        for index in (0, 2, 6, 8):\n            if not ttt_board[index]:\n                move = index\n                break\n    if move < 0:\n        move = ttt_board.index(\"\")\n    ttt_place(move)\n\n\ndef ttt_move(index):\n    if ttt_over or ttt_board[index] or ttt_cpu and ttt_turn != \"X\":\n        return\n    ttt_place(index)\n    if ttt_cpu and not ttt_over:\n        ttt_cpu_move()\n",
    "handlers": {
