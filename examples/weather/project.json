    "module": "import forecast\n\ncity_index = 0\nfahrenheit = False\nseconds = 0\n\n\ndef refresh():\n    city = forecast.CITIES[city_index]\n    condition, temps = forecast.fetch(city)\n    ui.city.set_text(city)\n    ui.temperature.set_text(forecast.show(temps[0], fahrenheit))\n    ui.condition.set_text(condition)\n    names = (ui.day0_name, ui.day1_name, ui.day2_name, ui.day3_name, ui.day4_name)\n    values = (ui.day0_temp, ui.day1_temp, ui.day2_temp, ui.day3_temp, ui.day4_temp)\n    icons = (ui.day0_icon, ui.day1_icon, ui.day2_icon, ui.day3_icon, ui.day4_icon)\n    icon = {\"Sunny\": ui.img_sunny, \"Cloudy\": ui.img_cloudy, \"Rain\": ui.img_rain}[condition]\n    ui.current_icon.set_src(icon)\n    for index in range(5):\n        names[index].set_text(forecast.DAYS[index])\n        values[index].set_text(forecast.show(temps[index], fahrenheit))\n        icons[index].set_src(icon)\n",
    "handlers": {
      "main_screen_loaded": {
        "widget": "main",
        "event": "SCREEN_LOADED",
        "body": "refresh()"
      },
      "refresh_clicked": {
        "widget": "refresh",
        "event": "CLICKED",
        "body": "global city_index\ncity_index = (city_index + 1) % len(forecast.CITIES)\nrefresh()"
      },
      "clock_tick": {
        "widget": "clock",
        "event": "TICK",
        "body": "global seconds\nseconds += 1\nui.updated.set_text('5-day forecast - updated %d s ago' % seconds)"
      },
      "settings_button_clicked": {
        "widget": "settings_button",
        "event": "CLICKED",
        "body": "ui.load_page(ui.PAGE_SETTINGS)"
      },
      "back_clicked": {
        "widget": "back",
        "event": "CLICKED",
        "body": "ui.load_page(ui.PAGE_MAIN)"
      },
      "units_value_changed": {
        "widget": "units",
        "event": "VALUE_CHANGED",
        "body": "global fahrenheit\nfahrenheit = ui.units.has_state(lv.STATE.CHECKED)\nrefresh()"
      }
    }
  },
