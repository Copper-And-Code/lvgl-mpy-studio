  "modules": [
    {
      "id": "16961e21ed154c1abc217ebfdccd96ea",
      "name": "forecast",
      "source": "\"\"\"Forecast data. On a board with Wi-Fi, fetch() is the place to call a weather service.\"\"\"\n\nCITIES = (\"Catania\", \"Milan\", \"London\")\nDAYS = (\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\")\n_DATA = {\n    \"Catania\": (\"Sunny\", (24, 25, 23, 22, 24)),\n    \"Milan\": (\"Cloudy\", (12, 11, 9, 13, 14)),\n    \"London\": (\"Rain\", (8, 7, 9, 6, 8)),\n}\n\n\ndef fetch(city):\n    \"\"\"Return (condition, temperatures in Celsius for five days).\"\"\"\n    return _DATA[city]\n\n\ndef show(celsius, fahrenheit):\n    if fahrenheit:\n        return \"%d °F\" % (celsius * 9 // 5 + 32)\n    return \"%d °C\" % celsius\n"
    }
  ]
