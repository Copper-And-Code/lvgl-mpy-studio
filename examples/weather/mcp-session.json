  ["add_page", {"project": "{project}", "name": "settings"}],
  ["add_widgets", {"project": "{project}", "page": "settings", "widgets": [{"type": "panel", "name": "settings_background", "props": {"x": 0, "y": 0, "width": 480, "height": 480, "bgColor": "#0F1722", "radius": 0, "borderWidth": 0}}, {"type": "label", "name": "settings_title", "props": {"x": 20, "y": 20, "width": 300, "height": 30, "text": "Settings", "textColor": "#FFFFFF", "fontSize": 24}}, {"type": "label", "name": "units_label", "props": {"x": 20, "y": 120, "width": 300, "height": 30, "text": "Fahrenheit", "textColor": "#FFFFFF", "fontSize": 16}}, {"type": "switch", "name": "units", "props": {"x": 380, "y": 114, "width": 70, "height": 36}}, {"type": "button", "name": "back", "props": {"x": 140, "y": 416, "width": 200, "height": 48, "text": "Back", "fontSize": 16}}]}],
