  ["validate", {"project": "{project}"}],
  ["create_module", {"project": "{project}", "name": "forecast", "source": "\"\"\"Forecast data. On a board with Wi-Fi, fetch() is the place to call a weather service.\"\"\"\n\nCITIES = (\"Catania\", \"Milan\", \"London\")\nDAYS = (\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\")\n_DATA = {\n    \"Catania\": (\"Sunny\", (24, 25, 23, 22, 24)),\n    \"Milan\": (\"Cloudy\", (12, 11, 9, 13, 14)),\n    \"London\": (\"Rain\", (8, 7, 9, 6, 8)),\n}\n\n\ndef fetch(city):\n    \"\"\"Return (condition, temperatures in Celsius for five days).\"\"\"\n    return _DATA[city]\n\n\ndef show(celsius, fahrenheit):\n    if fahrenheit:\n        return \"%d F\" % (celsius * 9 // 5 + 32)\n    return \"%d C\" % celsius\n"}],
  ["set_module_code", {"project": "{project}", "code": "import forecast\n\ncity_index = 0\nfahrenheit = False\nseconds = 0\n\n\ndef refresh():\n    city = forecast.CITIES[city_index]\n    condition, temps = forecast.fetch(city)\n    ui.city.set_text(city)\n    ui.temperature.set_text(forecast.show(temps[0], fahrenheit))\n    ui.condition.set_text(condition)\n    names = (ui.day0_name, ui.day1_name, ui.day2_name, ui.day3_name, ui.day4_name)\n    values = (ui.day0_temp, ui.day1_temp, ui.day2_temp, ui.day3_temp, ui.day4_temp)\n    for index in range(5):\n        names[index].set_text(forecast.DAYS[index])\n        values[index].set_text(forecast.show(temps[index], fahrenheit))\n"}],
  ["set_handler", {"project": "{project}", "widget": "main", "body": "refresh()"}],
  ["set_handler", {"project": "{project}", "widget": "refresh", "body": "global city_index\ncity_index = (city_index + 1) % len(forecast.CITIES)\nrefresh()"}],
  ["set_handler", {"project": "{project}", "widget": "clock", "body": "global seconds\nseconds += 1\nui.updated.set_text('5-day forecast - updated %d s ago' % seconds)"}],
  ["set_handler", {"project": "{project}", "widget": "settings_button", "body": "ui.load_page(ui.PAGE_SETTINGS)"}],
  ["set_handler", {"project": "{project}", "widget": "back", "body": "ui.load_page(ui.PAGE_MAIN)"}],
  ["set_handler", {"project": "{project}", "widget": "units", "body": "global fahrenheit\nfahrenheit = ui.units.has_state(lv.STATE.CHECKED)\nrefresh()"}],
  ["simulate", {"project": "{project}", "steps": [{"action": "wait", "ms": 300}, {"action": "screenshot", "label": "start"}, {"action": "assert", "expr": "ui.temperature.get_text() == '24 C'"}, {"action": "tap", "widget": "refresh"}, {"action": "wait", "ms": 200}, {"action": "assert", "expr": "ui.city.get_text() == 'Milan'"}, {"action": "tap", "widget": "settings_button"}, {"action": "wait_until", "page": "settings"}, {"action": "tap", "widget": "units"}, {"action": "wait", "ms": 300}, {"action": "tap", "widget": "back"}, {"action": "wait_until", "page": "main"}, {"action": "eval", "expr": "(fahrenheit, ui.temperature.get_text(), ui.day4_temp.get_text(), seconds)"}, {"action": "wait", "ms": 3000}, {"action": "eval", "expr": "ui.updated.get_text()"}]}],
  ["save_scenario", {"project": "{project}", "name": "tour", "page": "main", "seed": 1, "steps": [{"action": "wait", "ms": 300}, {"action": "screenshot", "label": "catania"}, {"action": "tap", "widget": "refresh"}, {"action": "wait", "ms": 200}, {"action": "assert", "expr": "ui.city.get_text() == 'Milan'"}, {"action": "tap", "widget": "settings_button"}, {"action": "wait_until", "page": "settings"}, {"action": "tap", "widget": "units"}, {"action": "wait", "ms": 300}, {"action": "tap", "widget": "back"}, {"action": "wait_until", "page": "main"}, {"action": "assert", "expr": "ui.temperature.get_text() == '53 F'"}]}],
